{
  "name": "@customer-agent/unified-contracts",
  "private": true,
  "type": "module",
  "description": "统一权限、查询、操作、发布与悬浮窗的手写合同和运行时边界",
  "files": [
    "dist",
    "generated",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:runtime": "tsc -p tsconfig.build.json",
    "generate": "pnpm build:runtime && node scripts/generate-policy-artifacts.mjs --write",
    "check:generated": "pnpm build:runtime && node scripts/generate-policy-artifacts.mjs --check",
    "test:unit": "vitest run",
    "test:package": "pnpm build:runtime && node --test tests/package-entry.smoke.mjs",
    "test": "pnpm check:generated && pnpm test:unit && pnpm test:package",
    "benchmark": "pnpm build:runtime && node benchmarks/contract-projection.bench.mjs",
    "build": "pnpm check:generated && pnpm build:runtime"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
