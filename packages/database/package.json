{
  "name": "@customer-agent/database",
  "private": true,
  "type": "module",
  "description": "客服 Agent PostgreSQL 15 不可变 migration、账本与失败关闭核验模块",
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./testkit": {
      "types": "./src/testkit/index.ts",
      "import": "./dist/testkit/index.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-migrations.mjs",
    "check:generated": "node scripts/generate-migrations.mjs --check",
    "typecheck": "tsc --noEmit",
    "build:runtime": "tsc -p tsconfig.build.json",
    "test:package": "pnpm build:runtime && node --test tests/package-entry.smoke.mjs",
    "test:unit": "vitest run --exclude tests/postgres.integration.test.ts",
    "test:integration": "vitest run tests/postgres.integration.test.ts",
    "test": "pnpm check:generated && pnpm test:unit && pnpm test:package",
    "test:all": "pnpm test && pnpm test:integration",
    "build": "pnpm check:generated && pnpm build:runtime",
    "test:package:built": "node --test tests/package-entry.smoke.mjs",
    "test:built": "pnpm test:unit && pnpm test:package:built"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
