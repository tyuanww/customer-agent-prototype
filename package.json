{
  "name": "customer-agent-demo",
  "private": true,
  "type": "module",
  "description": "客服 Agent 产品实施仓 workspace；Electron 产品包位于 apps/desktop",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @customer-agent/desktop dev",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @customer-agent/contracts typecheck && pnpm --filter @customer-agent/desktop typecheck",
    "test": "pnpm --filter @customer-agent/contracts test && pnpm --filter @customer-agent/desktop test",
    "test:watch": "pnpm --filter @customer-agent/desktop test:watch",
    "test:float": "pnpm --filter @customer-agent/desktop test:float",
    "test:assets": "pnpm --filter @customer-agent/desktop test:assets",
    "test:e2e:float": "pnpm --filter @customer-agent/desktop test:e2e:float",
    "build": "pnpm --filter @customer-agent/contracts build && pnpm --filter @customer-agent/desktop build",
    "preview": "pnpm --filter @customer-agent/desktop preview",
    "test:e2e": "pnpm --filter @customer-agent/desktop test:e2e",
    "electron:install": "pnpm --filter @customer-agent/desktop exec install-electron",
    "generate:mac-icon": "pnpm --filter @customer-agent/desktop generate:mac-icon",
    "generate:fox-head": "pnpm --filter @customer-agent/desktop generate:fox-head",
    "generate:app-icons": "pnpm --filter @customer-agent/desktop generate:app-icons",
    "contracts:intake": "node scripts/customer-agent-contract-set.mjs ingest",
    "contracts:verify": "node scripts/customer-agent-contract-set.mjs verify",
    "contracts:generate": "pnpm --filter @customer-agent/contracts generate",
    "contracts:codegen:check": "pnpm --filter @customer-agent/contracts check:generated",
    "test:contract": "pnpm --filter @customer-agent/contracts test",
    "workspace:size": "node scripts/workspace-hygiene.mjs size",
    "workspace:check": "node scripts/workspace-hygiene.mjs check",
    "clean:preview": "node scripts/workspace-hygiene.mjs clean --scope=generated",
    "clean:generated": "node scripts/workspace-hygiene.mjs clean --scope=generated --apply",
    "clean:deep:preview": "node scripts/workspace-hygiene.mjs clean --scope=deep",
    "clean:deep": "node scripts/workspace-hygiene.mjs clean --scope=deep --apply",
    "package:win": "pnpm --filter @customer-agent/desktop package:win",
    "package:mac:local": "pnpm --filter @customer-agent/desktop package:mac:local",
    "package:mac": "pnpm --filter @customer-agent/desktop package:mac"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.44.0"
  }
}
