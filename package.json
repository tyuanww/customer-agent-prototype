{
  "name": "customer-agent-demo",
  "private": true,
  "type": "module",
  "description": "客服 Agent 产品实施仓 workspace；Electron 产品包位于 apps/desktop，正式 API 骨架位于 apps/api",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @customer-agent/desktop dev",
    "dev:api": "pnpm --filter @customer-agent/api dev",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @customer-agent/contracts typecheck && pnpm --filter @customer-agent/database typecheck && pnpm --filter @customer-agent/api typecheck && pnpm --filter @customer-agent/desktop typecheck",
    "test": "pnpm build:services && pnpm test:built",
    "test:artifact-boundary": "node --test scripts/formal-artifact-boundary.test.mjs",
    "test:watch": "pnpm --filter @customer-agent/desktop test:watch",
    "test:float": "pnpm --filter @customer-agent/desktop test:float",
    "test:assets": "pnpm --filter @customer-agent/desktop test:assets",
    "test:e2e:float": "pnpm --filter @customer-agent/desktop test:e2e:float",
    "test:e2e:windows-feasibility": "pnpm --filter @customer-agent/desktop test:e2e:windows-feasibility",
    "build": "pnpm build:services && pnpm --filter @customer-agent/desktop build",
    "preview": "pnpm --filter @customer-agent/desktop preview",
    "test:e2e": "pnpm --filter @customer-agent/desktop test:e2e",
    "electron:install": "pnpm --filter @customer-agent/desktop exec install-electron",
    "generate:mac-icon": "pnpm --filter @customer-agent/desktop generate:mac-icon",
    "generate:fox-head": "pnpm --filter @customer-agent/desktop generate:fox-head",
    "generate:app-icons": "pnpm --filter @customer-agent/desktop generate:app-icons",
    "contracts:intake": "node scripts/customer-agent-contract-set.mjs ingest",
    "contracts:verify": "node scripts/customer-agent-contract-set.mjs verify",
    "contracts:generate": "pnpm --filter @customer-agent/contracts generate",
    "contracts:codegen:check": "pnpm --filter @customer-agent/contracts check:generated",
    "db:migrations:generate": "pnpm --filter @customer-agent/database generate",
    "db:migrations:check": "pnpm --filter @customer-agent/database check:generated",
    "artifact:m0:build": "node scripts/build-m0-formal-candidate.mjs",
    "artifact:m0:verify": "node scripts/formal-artifact-boundary.mjs",
    "verify:formal-artifacts": "pnpm artifact:m0:verify",
    "check": "pnpm workspace:check && pnpm contracts:verify && pnpm contracts:codegen:check && pnpm db:migrations:check && pnpm lint && pnpm typecheck && pnpm artifact:m0:build --check && pnpm artifact:m0:verify",
    "test:db": "pnpm --filter @customer-agent/database test:all",
    "test:db:integration": "pnpm --filter @customer-agent/database test:integration",
    "test:contract": "pnpm --filter @customer-agent/contracts test",
    "test:api": "pnpm --filter @customer-agent/api test",
    "test:search-decision": "pnpm --filter @customer-agent/api test:search-decision",
    "test:search-decision:acceptance": "pnpm --filter @customer-agent/api test:search-decision:acceptance",
    "test:search-decision:known-fail": "pnpm --filter @customer-agent/api test:search-decision:known-fail",
    "test:search-decision:round1": "pnpm --filter @customer-agent/api test:search-decision:round1",
    "test:g1a:synthetic": "pnpm --filter @customer-agent/contracts exec vitest run tests/search-gold.test.ts && pnpm --filter @customer-agent/api test:g1a:synthetic",
    "test:g1a:e0": "pnpm --filter @customer-agent/api test:g1a:e0:synthetic",
    "test:g1a:e0:package": "pnpm --filter @customer-agent/api test:g1a:e0:package",
    "workspace:size": "node scripts/workspace-hygiene.mjs size",
    "workspace:check": "node scripts/workspace-hygiene.mjs check",
    "clean:preview": "node scripts/workspace-hygiene.mjs clean --scope=generated",
    "clean:generated": "node scripts/workspace-hygiene.mjs clean --scope=generated --apply",
    "clean:deep:preview": "node scripts/workspace-hygiene.mjs clean --scope=deep",
    "clean:deep": "node scripts/workspace-hygiene.mjs clean --scope=deep --apply",
    "package:win": "pnpm --filter @customer-agent/desktop package:win",
    "package:mac:local": "pnpm --filter @customer-agent/desktop package:mac:local",
    "package:mac": "pnpm --filter @customer-agent/desktop package:mac",
    "build:services": "pnpm --filter @customer-agent/contracts build && pnpm --filter @customer-agent/database build && pnpm --filter @customer-agent/api build",
    "test:built": "pnpm --filter @customer-agent/contracts test:built && pnpm --filter @customer-agent/database test:built && pnpm --filter @customer-agent/api test:built && pnpm --filter @customer-agent/desktop test && pnpm test:artifact-boundary && pnpm test:workflow",
    "docs:check": "node scripts/check-documentation.mjs",
    "verify:plan": "node scripts/verification-policy.mjs plan",
    "test:workflow": "node --test scripts/verification-policy.test.mjs",
    "test:g1a:e0:ci": "node scripts/run-g1a-synthetic.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.44.0"
  }
}
